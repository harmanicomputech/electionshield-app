APP_NAME="Election Shield"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://CHANGE-ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# One-time key for creating the first admin account at /login.
ADMIN_PASSWORD={{ADMIN_PASSWORD}}

# Put these two values in the USSD server's .env as DASHBOARD_API_TOKEN and
# DASHBOARD_WEBHOOK_SECRET, with DASHBOARD_WEBHOOK_URL=https://<this site>/api/ussd-events
USSD_WEBHOOK_TOKEN={{USSD_WEBHOOK_TOKEN}}
USSD_WEBHOOK_SECRET={{USSD_WEBHOOK_SECRET}}

# The USSD service's read API: ELECTION_API_TOKEN from the USSD server's .env.
USSD_API_URL=https://ussd.techatronagency.com/api
USSD_API_TOKEN=CHANGE-ME

# The party this situation room works for (weak links are worked out for it).
ELECTION_PRINCIPAL_PARTY=
