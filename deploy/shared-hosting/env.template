APP_NAME="Election Shield"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://CHANGE-ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

# File sessions and cache work before the database is set up (first login).
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# One-time key for creating the first admin account at /login.
ADMIN_PASSWORD={{ADMIN_PASSWORD}}

# Put these two values in the USSD server's .env as DASHBOARD_API_TOKEN and
# DASHBOARD_WEBHOOK_SECRET, with DASHBOARD_WEBHOOK_URL=https://<this site>/api/ussd-events
USSD_WEBHOOK_TOKEN={{USSD_WEBHOOK_TOKEN}}
USSD_WEBHOOK_SECRET={{USSD_WEBHOOK_SECRET}}

# The USSD service's read API: ELECTION_API_TOKEN from the USSD server's .env.
USSD_API_URL=https://ussd.techatronagency.com/api
USSD_API_TOKEN=CHANGE-ME

# The party this situation room works for (weak links are worked out for it).
ELECTION_PRINCIPAL_PARTY=

# Web Push contact (keys are created on the System page).
VAPID_SUBJECT=mailto:CHANGE-ME

# Broadcasts: SMS through Africa's Talking (same account as the USSD service).
AFRICASTALKING_USERNAME=CHANGE-ME
AFRICASTALKING_API_KEY=CHANGE-ME
AFRICASTALKING_SENDER_ID=
SMS_CALLBACK_SECRET={{SMS_CALLBACK_SECRET}}

# Broadcasts: WhatsApp (optional; needs a verified Meta business).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN={{WHATSAPP_VERIFY_TOKEN}}
